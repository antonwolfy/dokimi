{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/napetrov/agent-benchmark/schemas/task_runs.v1.json",
  "title": "Executable task-run artifact v1",
  "type": "object",
  "required": [
    "schema_version",
    "harnesses",
    "tasks",
    "results",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "task_runs.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_harness": {
      "type": [
        "string",
        "null"
      ]
    },
    "harnesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repeats": {
      "type": "integer",
      "minimum": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "metadata",
          "verifier",
          "agent",
          "environment"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "verifier": {
            "type": "object"
          },
          "agent": {
            "type": "object"
          },
          "environment": {
            "type": "object"
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task",
          "harness",
          "passed",
          "metrics",
          "operations"
        ],
        "properties": {
          "task": {
            "type": "string"
          },
          "harness": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "returncode": {
            "type": "integer"
          },
          "elapsed_sec": {
            "type": "number"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "reward": {
            "type": [
              "number",
              "null"
            ]
          },
          "stdout_tail": {
            "type": "string"
          },
          "stderr_tail": {
            "type": "string"
          },
          "output_dir": {
            "type": [
              "string",
              "null"
            ]
          },
          "repeat": {
            "type": "integer",
            "minimum": 1
          },
          "metrics": {
            "type": "object",
            "required": [
              "operation_count",
              "operations_by_type"
            ],
            "properties": {
              "dry_run": {
                "type": "boolean"
              },
              "timeout_sec": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "stdout_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "stderr_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "operation_count": {
                "type": "integer",
                "minimum": 0
              },
              "operations_by_type": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "exploration_metrics": {
                "type": "object",
                "description": "Optional exploration-quality block. Emitted only when the operation stream contains read/search/subagent/edit signal. Metrics that cannot be derived from the available telemetry are null.",
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "name",
                "status",
                "elapsed_sec",
                "metadata"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "elapsed_sec": {
                  "type": "number"
                },
                "metadata": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "per_harness",
        "comparisons"
      ],
      "properties": {
        "per_harness": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "n",
              "passed",
              "elapsed_sec",
              "operation_count",
              "operations_by_type",
              "pass_rate",
              "avg_reward"
            ],
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "elapsed_sec": {
                "type": "number"
              },
              "operation_count": {
                "type": "integer",
                "minimum": 0
              },
              "operations_by_type": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "pass_rate": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "avg_reward": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cost": {
                "type": "object",
                "description": "Rolled-up LLM telemetry; total_cost_usd is null when no call was priced.",
                "properties": {
                  "total_cost_usd": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "cost_known_n": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": true
              },
              "per_task": {
                "type": "object",
                "description": "Per-task pass breakdown for this harness.",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "n",
                    "passed",
                    "pass_rate"
                  ],
                  "properties": {
                    "n": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "passed": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "pass_rate": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "comparisons": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "baseline_harness",
              "pass_rate_delta",
              "passed_delta",
              "operation_count_delta"
            ],
            "properties": {
              "baseline_harness": {
                "type": "string"
              },
              "pass_rate_delta": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "passed_delta": {
                "type": "integer"
              },
              "operation_count_delta": {
                "type": "integer"
              },
              "cost_delta_usd": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "mcnemar": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Paired significance on the binary pass/fail outcomes, per (task, repeat) cell against the baseline harness. McNemar's exact test: only the discordant cells carry evidence. Null when no cell is shared with the baseline. p_exact and significant are null when there is no discordant pair at all — no evidence either way, as distinct from evidence of no difference. p_adjusted is Holm-corrected across the non-baseline harnesses in the same sweep.",
                "properties": {
                  "test": {
                    "const": "mcnemar_exact"
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n_gained": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Cells this harness passed and the baseline failed."
                  },
                  "n_lost": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Cells the baseline passed and this harness failed."
                  },
                  "n_both_passed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n_both_failed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n_discordant": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n_excluded": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Cells dropped from the pairing, measured against every cell either harness attempted: present for one harness only, or the harness errored."
                  },
                  "n_units": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Independent units behind the n pairs (the distinct tasks). Equals n when repeats is 1."
                  },
                  "pseudo_replicated": {
                    "type": "boolean",
                    "description": "True when n_units < n, i.e. repeats were paired as separate cells. McNemar assumes independent pairs, so p_exact is then anti-conservative."
                  },
                  "paired_pass_rate_delta": {
                    "type": "number",
                    "description": "(n_gained - n_lost) / n over the shared cells, as a fraction. Distinct from the sibling pass_rate_delta, which subtracts two marginal pass rates over every row each harness ran."
                  },
                  "ci_lo": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "ci_hi": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "ci_confidence": {
                    "type": "number"
                  },
                  "p_exact": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "p_adjusted": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "correction": {
                    "type": "string"
                  },
                  "correction_family": {
                    "const": "harnesses",
                    "description": "Names the hypothesis family these p-values were corrected within. The judged track's arm and interaction families are corrected separately, so the multiplier here counts harnesses only."
                  },
                  "family_size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "significant": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "significant_adjusted": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  }
}
