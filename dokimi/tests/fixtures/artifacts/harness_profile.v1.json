{
  "bin": "claude",
  "bridge": {
    "content": "@AGENTS.md",
    "for": "AGENTS.md",
    "write": "CLAUDE.md"
  },
  "config_dir_env": "CLAUDE_CONFIG_DIR",
  "egress": [
    "bedrock-runtime.*.amazonaws.com",
    "api.anthropic.com"
  ],
  "endpoint_env": "ANTHROPIC_BASE_URL",
  "env_allow": [
    "PATH",
    "HOME",
    "LANG",
    "SYSTEMROOT",
    "AWS_REGION",
    "AWS_BEARER_TOKEN_BEDROCK",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_BASE_URL",
    "CLAUDE_CODE_USE_BEDROCK",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY"
  ],
  "env_set": {
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "guidance": {
    "imports": "@path",
    "names": [
      "CLAUDE.md",
      "CLAUDE.local.md",
      "AGENTS.md"
    ],
    "notes": "Measured on CLI 2.1.286: it reads AGENTS.md only when no CLAUDE.md is in the directory chain it starts in, and one CLAUDE.md turns AGENTS.md off for the whole session. 2.1.241 and 2.1.250 read no AGENTS.md beside a root CLAUDE.md; without one they were not measured. The reach probe measures this per version.",
    "resolution": "ancestors-of-cwd + lazy-on-subtree-access"
  },
  "invoke": [
    "{bin}",
    "-p",
    "{prompt}",
    "--model",
    "{model}",
    "--output-format",
    "stream-json",
    "--verbose",
    "--max-turns",
    "{max_turns}",
    "--max-budget-usd",
    "{budget}",
    "--no-session-persistence",
    "--strict-mcp-config",
    "--permission-mode",
    "bypassPermissions",
    "{tools}"
  ],
  "name": "claude-code",
  "schema": "harness_profile.v1",
  "tools": {
    "all": [
      "--disallowedTools",
      "WebFetch",
      "WebSearch"
    ],
    "none": [
      "--tools",
      ""
    ],
    "read": [
      "--tools",
      "Read"
    ]
  },
  "trace": "claude-stream-json",
  "version_cmd": [
    "{bin}",
    "--version"
  ]
}
